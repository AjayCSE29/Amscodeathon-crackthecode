PORT=8787
PISTON_URL=http://127.0.0.1:2000/api/v2
API_HOST=http://localhost:8787

ALLOWED_HOSTS=

RUN_TIMEOUT_MS=10000
QUEUE_TIMEOUT_MS=30000
MAX_CONCURRENCY=8
RATE_LIMIT_PER_MIN=30
MAX_CODE_BYTES=65536
MAX_STDIN_BYTES=16384
BODY_LIMIT_BYTES=196608
SYNC_BODY_LIMIT_BYTES=4194304
LOGIN_RATE_LIMIT_PER_MIN=10
SYNC_RATE_LIMIT_PER_MIN=6
ROUND2_CONFIRM_RATE_LIMIT_PER_MIN=60
ROUND3_CONFIRM_RATE_LIMIT_PER_MIN=60
ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10
ADMIN_RATE_LIMIT_PER_MIN=30
EVAL_RATE_LIMIT_PER_MIN=5

# LLM grading. Server-only; never prefix with VITE_.
# Self-hosted or third-party OpenAI-compatible endpoint takes precedence over Gemini.
# LLM_API_URL=http://192.0.2.10:8000/v1
# LLM_MODEL=Qwen/Qwen3.5-4B
# LLM_API_KEY=
# LLM_TIMEOUT_MS=15000
# LLM_MAX_CONCURRENCY=3
# LLM_QUOTA_BACKOFF_MS=60000
# Retries with exponential backoff (up to LLM_QUOTA_BACKOFF_MS) on 408/429/5xx.
# Set to 1 to disable all LLM grading and fall back to deterministic Round 1 scoring.
# LLM_DISABLE=0

# Gemini grading. Server-only; never prefix with VITE_.
# Used only when LLM_API_URL is unset.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=15000
# GEMINI_MAX_CONCURRENCY=3
# GEMINI_QUOTA_BACKOFF_MS=60000
# Retries with exponential backoff (up to GEMINI_QUOTA_BACKOFF_MS) on 408/429/5xx.
# Set to 1 to disable Gemini specifically (LLM_API_URL still takes precedence).
# GEMINI_DISABLE=0

# Admin dashboard. Server-only; never prefix with VITE_.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Server-only. Never prefix these with VITE_ — Vite inlines them into the client bundle.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY.
# AUTH_TOKEN_SECRET=
# Optional. Defaults to a separate key derived from the token secret above.
# ADMIN_TOKEN_SECRET=
