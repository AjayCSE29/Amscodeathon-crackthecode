@theme {
  --font-sans: "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system,
    "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas,
    monospace;

  /* Canvas & surfaces */
  --color-surface: #faf8ff;
  --color-surface-dim: #d2d9f4;
  --color-surface-bright: #faf8ff;
  --color-surface-container-lowest: #ffffff;
  --color-surface-container-low: #f2f3ff;
  --color-surface-container: #eaedff;
  --color-surface-container-high: #e2e7ff;
  --color-surface-container-highest: #dae2fd;
  --color-surface-variant: #dae2fd;
  --color-on-surface: #131b2e;
  --color-on-surface-variant: #3f4850;
  --color-inverse-surface: #283044;
  --color-inverse-on-surface: #eef0ff;
  --color-terminal: #0b1226;
  --color-terminal-muted: #8792ad;

  /* Outlines & dividers */
  --color-outline: #707881;
  --color-outline-variant: #bfc7d2;

  /* Primary (cyan-blue) */
  --color-primary: #006194;
  --color-on-primary: #ffffff;
  --color-primary-container: #007bb9;
  --color-on-primary-container: #fdfcff;
  --color-primary-fixed: #cce5ff;
  --color-on-primary-fixed: #001d31;
  --color-on-primary-fixed-variant: #004b73;
  --color-inverse-primary: #93ccff;

  /* Secondary (indigo-violet) */
  --color-secondary: #712ae2;
  --color-on-secondary: #ffffff;
  --color-secondary-container: #8a4cfc;
  --color-on-secondary-container: #fffbff;
  --color-secondary-fixed: #eaddff;
  --color-on-secondary-fixed: #25005a;
  --color-secondary-fixed-dim: #d2bbff;

  /* Tertiary (emerald / verified) */
  --color-tertiary: #006947;
  --color-on-tertiary: #ffffff;
  --color-tertiary-container: #00855b;
  --color-on-tertiary-container: #f5fff6;
  --color-tertiary-fixed: #6ffbbe;
  --color-on-tertiary-fixed: #002113;
  --color-on-tertiary-fixed-variant: #005236;
  --color-tertiary-fixed-dim: #4edea3;

  /* Error / negative marking */
  --color-error: #ba1a1a;
  --color-on-error: #ffffff;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;

  /* Supplementary semantics (amber : review flag) */
  --color-amber: #f59e0b;
  --color-amber-dark: #b45309;
  --color-amber-soft: #fffbeb;
  --color-amber-border: #fde68a;
  --color-amber-hover: #fef3c7;

  /* Typography scale (DESIGN.md) */
  --text-headline-lg: 1.75rem;
  --text-headline-lg--line-height: 2.25rem;
  --text-headline-lg--letter-spacing: -0.02em;
  --text-headline-lg--font-weight: 600;
  --text-headline-md: 1.25rem;
  --text-headline-md--line-height: 1.75rem;
  --text-headline-md--letter-spacing: -0.01em;
  --text-headline-md--font-weight: 600;
  --text-body-lg: 1rem;
  --text-body-lg--line-height: 1.625rem;
  --text-body-md: 0.875rem;
  --text-body-md--line-height: 1.375rem;
  --text-code-body: 0.8125rem;
  --text-code-body--line-height: 1.25rem;
  --text-code-inline: 0.75rem;
  --text-code-inline--line-height: 1rem;
  --text-code-inline--font-weight: 500;
  --text-label-md: 0.75rem;
  --text-label-md--line-height: 1rem;
  --text-label-md--font-weight: 600;
  --text-label-md--letter-spacing: 0.04em;
  --text-label-sm: 0.6875rem;
  --text-label-sm--line-height: 0.875rem;
  --text-label-sm--font-weight: 500;
  --text-label-sm--letter-spacing: 0.05em;

  /* Spacing */
  --spacing-gutter: 1.5rem;
  --spacing-gutter-mobile: 0.75rem;
  --spacing-margin: 2rem;
  --spacing-margin-mobile: 1rem;
  --spacing-space-xs: 0.25rem;
  --spacing-space-sm: 0.5rem;
  --spacing-space-md: 1rem;
  --spacing-space-lg: 1.5rem;
  --spacing-space-xl: 2rem;

  /* Radius — 4–12px disciplined profile */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
}
